<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.openepcis</groupId>
        <artifactId>openepcis-bom</artifactId>
        <version>0.9.4</version>
    </parent>
    <artifactId>openepcis-quarkus-rest-api-ce</artifactId>
    <version>0.9.4</version>
    <name>OpenEPCIS EPCIS Repository, Community Edition</name>
    <description>
        The EPCIS 2.0 repository of OpenEPCIS as one container: capture, query and subscriptions
        over OpenSearch and Kafka, assembled from the Apache-2.0 artifacts on Maven Central.
        Single-tenant, without document-level security. Nothing in this build comes from
        anywhere but Maven Central, and the enforcer refuses any Business-edition artifact.
    </description>
    <url>https://github.com/openepcis/epcis-repository-ce</url>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <scm>
        <connection>scm:git:git://github.com/openepcis/epcis-repository-ce.git</connection>
        <developerConnection>scm:git:ssh://github.com:openepcis/epcis-repository-ce.git</developerConnection>
        <url>https://github.com/openepcis/epcis-repository-ce/tree/main</url>
    </scm>
    <properties>
        <!-- one platform version for every OpenEPCIS artifact; the bom parent above is the same -->
        <openepcis.version>0.9.4</openepcis.version>
        <quarkus.container-image.registry>ghcr.io</quarkus.container-image.registry>
        <quarkus.container-image.group>openepcis</quarkus.container-image.group>
        <quarkus.container-image.name>openepcis-quarkus-rest-api-ce</quarkus.container-image.name>
    </properties>
    <dependencies>
        <dependency>
            <groupId>io.openepcis</groupId>
            <artifactId>quarkus-rest-application</artifactId>
            <version>${openepcis.version}</version>
        </dependency>
        <dependency>
            <groupId>io.openepcis</groupId>
            <artifactId>quarkus-capture-topology</artifactId>
            <version>${openepcis.version}</version>
        </dependency>
        <dependency>
            <groupId>io.openepcis</groupId>
            <artifactId>openepcis-reactive-event-publisher</artifactId>
            <version>${openepcis.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-container-image-jib</artifactId>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>community-edition-boundary</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>io.openepcis:openepcis-document-converter-sax</exclude>
                                        <exclude>io.openepcis:keycloak-api-key-*</exclude>
                                        <exclude>io.openepcis:quarkus-auth-keycloak</exclude>
                                        <exclude>io.openepcis:quarkus-service-oidc</exclude>
                                        <exclude>io.openepcis:quarkus-service-user-keycloak</exclude>
                                        <exclude>io.openepcis:openepcis-onboarding</exclude>
                                        <exclude>io.openepcis:openepcis-multitenancy</exclude>
                                        <exclude>io.openepcis:openepcis-instance-masterdata</exclude>
                                        <exclude>io.openepcis:openepcis-azure-blob-service</exclude>
                                        <exclude>io.openepcis:openepcis-repository-es</exclude>
                                        <exclude>io.openepcis.vc:*</exclude>
                                        <exclude>org.keycloak:*</exclude>
                                        <exclude>com.azure:*</exclude>
                                    </excludes>
                                    <message>The Community Edition image must not contain Business-edition or proprietary artifacts.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <configuration>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
